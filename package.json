  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.11.0",
    "markdown-it": "^14.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
