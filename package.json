{
  "name": "ai-infra-learning",
  "version": "1.0.0",
  "description": "Windows Electron MVP for the AI Infra learning system",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
